# Sao chép thành .env (KHÔNG commit .env). Giá trị dưới đây chỉ là ví dụ.
# Tạo JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ckd
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=60
